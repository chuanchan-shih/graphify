# 從 Meta Graph API Explorer 取得
# https://developers.facebook.com/tools/explorer/

# FB 粉絲專頁 ID（粉專首頁 → 關於 → 頁面ID）
FB_PAGE_ID=123456789

# 粉專的 Page Access Token（需有 pages_manage_posts + instagram_basic + instagram_content_publish 權限）
FB_PAGE_ACCESS_TOKEN=EAABsbCS...

# IG 商業帳號 ID
# Graph API Explorer: GET /me/accounts → 找到你的粉專 → connected_instagram_account
IG_USER_ID=17841400000000000

PORT=3000
